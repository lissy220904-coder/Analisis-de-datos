        "import matplotlib.pyplot as plt\n",
        "import matplotlib.gridspec as gridspec\n",
        "\n",
        "# ---------------------------------------------------------\n",
        "# PUNTO 4: DISPERSIÓN CON PROYECCIÓN DE HISTOGRAMAS EN CADA EJE\n",
        "# ---------------------------------------------------------\n",
        "\n",
        "fig = plt.figure(figsize=(8, 8))\n",
        "gs = gridspec.GridSpec(4, 4)\n",
        "\n",
        "# Definir paneles: centro (dispersión), arriba (hist X), derecha (hist Y)\n",
        "ax_main = fig.add_subplot(gs[1:4, 0:3])\n",
        "ax_xhist = fig.add_subplot(gs[0, 0:3], sharex=ax_main)\n",
        "ax_yhist = fig.add_subplot(gs[1:4, 3], sharey=ax_main)\n",
        "\n",
        "# 1. Dispersión principal\n",
        "ax_main.scatter(X, Y, alpha=0.3, color='#1f77b4', s=15)\n",
        "ax_main.set_xlabel('Perigeo $X$ (km)', fontsize=11)\n",
        "ax_main.set_ylabel('Apogeo $Y$ (km)', fontsize=11)\n",
        "ax_main.grid(True, linestyle='--', alpha=0.5)\n",
        "\n",
        "# 2. Histograma de proyección en el eje X (arriba)\n",
        "ax_xhist.hist(X, bins=30, color='#6baed6', edgecolor='black', alpha=0.7)\n",
        "ax_xhist.tick_params(labelbottom=False)\n",
        "ax_xhist.set_ylabel('Frecuencia $X$')\n",
        "ax_xhist.grid(True, linestyle='--', alpha=0.5)\n",
        "\n",
        "# 3. Histograma de proyección en el eje Y (derecha)\n",
        "ax_yhist.hist(Y, bins=30, orientation='horizontal', color='#6baed6', edgecolor='black', alpha=0.7)\n",
        "ax_yhist.tick_params(labelleft=False)\n",
        "ax_yhist.set_xlabel('Frecuencia $Y$')\n",
        "ax_yhist.grid(True, linestyle='--', alpha=0.5)\n",
        "\n",
        "plt.suptitle('Punto 4: Proyección Marginal de $X$ e $Y$', fontsize=13, fontweight='bold', y=0.93)\n",
        "plt.show()"
