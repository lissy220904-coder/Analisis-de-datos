        "# --- AJUSTE 1: DATOS DISPERSOS ORIGINALES ---\n",
        "m_raw, b_raw = np.polyfit(X, Y, 1)\n",
        "cov_raw = np.polyfit(X, Y, 1, cov=True)[1]\n",
        "dm_raw = np.sqrt(cov_raw[0, 0])\n",
        "db_raw = np.sqrt(cov_raw[1, 1])\n",
        "cov_mb_raw = cov_raw[0, 1]\n",
        "\n",
        "# --- MEDIAS POR INTERVALO (BINS) EN X Y EN Y ---\n",
        "num_bins = 12\n",
        "edges = np.linspace(np.min(X), np.max(X), num_bins + 1)\n",
        "\n",
        "x_bin, y_bin = [], []\n",
        "sx_bin, sy_bin = [], []\n",
        "\n",
        "for i in range(num_bins):\n",
        "    if i < num_bins - 1:\n",
        "        mask = (X >= edges[i]) & (X < edges[i + 1])\n",
        "    else:\n",
        "        mask = (X >= edges[i]) & (X <= edges[i + 1])\n",
        "\n",
        "    if np.sum(mask) > 1:\n",
        "        x_bin.append(np.mean(X[mask]))\n",
        "        y_bin.append(np.mean(Y[mask]))\n",
        "        sx_bin.append(np.std(X[mask], ddof=1))\n",
        "        sy_bin.append(np.std(Y[mask], ddof=1))\n",
        "\n",
        "x_bin = np.array(x_bin)\n",
        "y_bin = np.array(y_bin)\n",
        "sx_bin = np.array(sx_bin)\n",
        "sy_bin = np.array(sy_bin)\n",
        "\n",
        "# --- AJUSTE 2: PUNTOS PROMEDIADOS POR BIN ---\n",
        "m_bin, b_bin = np.polyfit(x_bin, y_bin, 1)\n",
        "cov_bin = np.polyfit(x_bin, y_bin, 1, cov=True)[1]\n",
        "dm_bin = np.sqrt(cov_bin[0, 0])\n",
        "db_bin = np.sqrt(cov_bin[1, 1])\n",
        "cov_mb_bin = cov_bin[0, 1]\n",
        "\n",
        "# --- PROPAGACIÓN DE ERROR EN LA RECTA ---\n",
        "x_grid = np.linspace(np.min(X), np.max(X), 150)\n",
        "\n",
        "y_fit_raw = m_raw * x_grid + b_raw\n",
        "dy_fit_raw = np.sqrt((x_grid**2) * (dm_raw**2) + (db_raw**2) + 2 * x_grid * cov_mb_raw)\n",
        "\n",
        "y_fit_bin = m_bin * x_grid + b_bin\n",
        "dy_fit_bin = np.sqrt((x_grid**2) * (dm_bin**2) + (db_bin**2) + 2 * x_grid * cov_mb_bin)\n",
        "\n",
        "# --- GRÁFICA COMPARATIVA ---\n",
        "plt.figure(figsize=(8.5, 5.2))\n",
        "\n",
        "# Puntos dispersos originales\n",
        "plt.scatter(X, Y, alpha=0.2, color=\"gray\", s=14, label=\"Datos dispersos (X, Y)\")\n",
        "\n",
        "# Ajuste sobre datos dispersos + banda propagada\n",
        "plt.plot(x_grid, y_fit_raw, color=\"#1f77b4\", lw=2, label=rf\"Ajuste dispersos: $y = {m_raw:.2f}x + {b_raw:.1f}$\")\n",
        "plt.fill_between(x_grid, y_fit_raw - dy_fit_raw, y_fit_raw + dy_fit_raw, color=\"#1f77b4\", alpha=0.18, label=\"Propagación error (dispersos)\")\n",
        "\n",
        "# Medias por intervalo con barras de error en X y Y\n",
        "plt.errorbar(\n",
        "    x_bin, y_bin,\n",
        "    xerr=sx_bin, yerr=sy_bin,\n",
        "    fmt=\"o\", color=\"crimson\", ecolor=\"crimson\",\n",
        "    elinewidth=1.3, capsize=3, markersize=5,\n",
        "    label=r\"Media $\\pm$ desv. est. por bin (X, Y)\"\n",
        ")\n",
        "\n",
        "# Ajuste sobre medias por bin + banda propagada\n",
        "plt.plot(x_grid, y_fit_bin, color=\"darkorange\", lw=2, linestyle=\"--\", label=rf\"Ajuste por bin: $y = {m_bin:.2f}x + {b_bin:.1f}$\")\n",
        "plt.fill_between(x_grid, y_fit_bin - dy_fit_bin, y_fit_bin + dy_fit_bin, color=\"orange\", alpha=0.2, label=\"Propagación error (por bin)\")\n",
        "\n",
        "plt.title(\"Medias por Intervalo y Ajustes con Propagación de Error\", fontsize=12, fontweight=\"bold\")\n",
        "plt.xlabel(\"Perigeo X (km)\")\n",
        "plt.ylabel(\"Apogeo Y (km)\")\n",
