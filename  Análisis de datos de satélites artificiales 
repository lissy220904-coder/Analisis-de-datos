        "# Ajuste lineal por mínimos cuadrados con covarianza\n",
        "p, cov = np.polyfit(X, Y, 1, cov=True)\n",
        "m, b = p[0], p[1]\n",
        "delta_m = np.sqrt(cov[0, 0])\n",
        "delta_b = np.sqrt(cov[1, 1])\n",
        "cov_mb = cov[0, 1]\n",
        "\n",
        "# Cálculo de Chi-cuadrada (bondad de ajuste)\n",
        "Y_modelo = m * X + b\n",
        "residuals = Y - Y_modelo\n",
        "sigma_y_i = np.std(residuals, ddof=2)\n",
        "chi2 = np.sum(((Y - Y_modelo) / sigma_y_i) ** 2)\n",
        "df = len(X) - 2\n",
        "chi2_reducido = chi2 / df\n",
        "\n",
        "print(\"=== PARÁMETROS Y CHI-CUADRADA ===\")\n",
        "print(\n",
        "    f\"Ecuación de ajuste: y = ({m:.4f} ± {delta_m:.4f})x + ({b:.2f} ± {delta_b:.2f})\"\n",
        ")\n",
        "print(f\"Estadístico Chi²: {chi2:.4f}\")\n",
        "print(f\"Grados de libertad (df): {df}\")\n",
        "print(f\"Chi² Reducido: {chi2_reducido:.4f}\")"
